# Hosted accounts (central Breakthrough sign-in). Leave every value unset and
# Devlinks is the browser-local editor; Account says "coming soon". Set them
# only where the issuer registered this deployment's exact callback (today:
# the protected Preview branch), then redeploy: the editor pages read this at
# build time.
AUTH_BASE_URL=
AUTH_SECRET=
AUTH_ISSUER_URL=https://accounts-preview.royeradames.com/api/auth
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=

# The project's existing Postgres, direct (unpooled) connection. Preview uses
# the devlinks_preview schema and Production the devlinks schema.
POSTGRES_URL_NON_POOLING=

# Read-only GitHub Packages token for @royeradames/auth (installs only).
NPM_TOKEN=
