{
  "name": "link-sharing-app",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "npm ci --no-audit --no-fund && next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test --test-force-exit tests/*.test.ts",
    "test:browser": "playwright test",
    "test:journey": "node --experimental-strip-types tests/accounts-journey.browser.mjs",
    "db:plan": "node scripts/migrate.mjs --plan",
    "db:migrate": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "@royer/auth": "npm:@royeradames/auth@0.1.0-rc.4",
    "@tanstack/react-form": "1.33.5",
    "@vercel/functions": "3.9.11",
    "next": "16.3.6",
    "pg": "8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "better-auth": "1.7.7",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  }
}
