{
  "name": "link-sharing-app",
  "version": "0.2.0",
  "private": true,
  "packageManager": "bun@1.4.4",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:setup && node --experimental-strip-types --test --test-force-exit tests/*.test.ts",
    "test:setup": "node tools/setup-coverage.mjs setup.json --root . --strict",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-form": "1.33.5",
    "clsx": "2.1.1",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  }
}
